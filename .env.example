MONGO_URL=mongodb://localhost:27018/ledgerly
PORT=4000

# Login con Google (obligatorio). Pasos en el README, sección «Login».
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Al menos 32 caracteres: openssl rand -base64 48
SESSION_SECRET=
OWNER_EMAIL=
# Otros mails que pueden entrar, separados por coma.
ALLOWED_EMAILS=
PUBLIC_URL=http://localhost:5173

# Importación desde Gmail (opcional). Pasos en el README, sección «Importar desde Gmail».
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# GMAIL_QUERY="has:attachment filename:pdf newer_than:90d"

# Importación desde iCloud (opcional). Pasos en el README, sección «Importar desde iCloud».
ICLOUD_USER=
# iCloud en producción: la contraseña de app va acá (en la Mac también sirve el Llavero).
# ICLOUD_APP_PASSWORD=
# ICLOUD_SINCE=2026-09-01
# ICLOUD_MAILBOXES=INBOX

# Búsqueda automática de mails (solo en Vercel, por cron): una vez por día, solo entre esos días de cada mes (puede cruzar el fin de mes). La hora la define vercel.json.
# MAIL_SYNC_DAYS=25-5

# Producción (Vercel): secreto con el que Vercel llama a los cron. Aleatorio, 32+ caracteres.
# CRON_SECRET=

# OCR de cupones en imagen con Google Cloud Vision (API key restringida a Cloud Vision).
# GOOGLE_VISION_API_KEY=

# Solo para bun run backup: string mongodb+srv:// de Atlas.
# ATLAS_URL=
