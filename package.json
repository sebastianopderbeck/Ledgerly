{
  "name": "ledgerly",
  "private": true,
  "type": "module",
  "workspaces": ["shared", "server", "client"],
  "trustedDependencies": ["esbuild", "mongodb-memory-server"],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev:server": "tsx watch --env-file=.env server/src/index.ts",
    "dev:client": "bun run --filter '@ledgerly/client' dev",
    "dev": "concurrently -n server,client -c blue,green \"bun run dev:server\" \"bun run dev:client\"",
    "seed": "tsx --env-file=.env server/src/rules/seedRules.ts",
    "seed:coupons": "tsx --env-file=.env server/src/import/seedCoupons.ts",
    "seed:fx": "tsx --env-file=.env server/src/import/backfillRates.ts",
    "seed:auto": "tsx --env-file=.env server/src/import/seedAutoCoupons.ts",
    "seed:fx:auto": "tsx --env-file=.env server/src/import/backfillAutoRates.ts",
    "seed:sueldo": "tsx --env-file=.env server/src/import/seedPayslips.ts",
    "seed:inflation": "tsx --env-file=.env server/src/import/backfillInflation.ts",
    "seed:macro": "tsx --env-file=.env server/src/import/backfillMacro.ts",
    "seed:fingerprints": "tsx --env-file=.env server/src/import/backfillFingerprints.ts"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.0.0",
    "concurrently": "^9.0.0"
  }
}
